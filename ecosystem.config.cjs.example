// PM2 process definition for TELERP on TelApp1 (mirrors C:\fastquote\ecosystem.config.cjs).
// Copy to ecosystem.config.cjs on the server and fill in the secrets. The real file is
// gitignored: it holds the production credentials and never leaves the server.
//
// Port 3001: FastQuote already owns 127.0.0.1:3000 on the same host. Bound to loopback so
// only the IIS reverse proxy can reach Node; nothing on the LAN talks to Node directly.
//
// NEXT_PUBLIC_* values are inlined at `next build`, NOT read at runtime. Put the AG Grid
// licence in C:\telerp\.env.production.local (also gitignored) so the build sees it.
module.exports = {
  apps: [{
    name: 'telerp',
    script: './node_modules/next/dist/bin/next',
    args: 'start -H 127.0.0.1 -p 3001',
    cwd: __dirname,
    interpreter: 'node',
    env: {
      SOFT1_ERP_HOST: 'teldb2',
      SOFT1_ERP_PORT: '1433',
      SOFT1_ERP_DB: 'SOFT1_ERP',
      SOFT1_ERP_INTEGRATED: 'false',
      SOFT1_ERP_USER: 'svc_telerp',
      SOFT1_ERP_PASSWORD: 'change-me',
      SOFT1_ERP_TRUST_CERT: 'true',
      SOFT1_ERP_ENCRYPT: 'true',
      SOFT1_ERP_REQUEST_TIMEOUT: '30000',

      TELERP_DEFAULT_COMPANY: '1',
    },
  }],
};
