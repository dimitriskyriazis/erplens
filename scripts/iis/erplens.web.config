<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS front for ERPLens on TelApp1. Lives at C:\apps\erplens\wwwroot\web.config (the IIS site
  root), NOT in C:\erplens. Copy it there on first install and after every change.

  Authentication, the FastQuote way: the site is ANONYMOUS everywhere except /api/me and
  /api/sso, where Windows authentication is required (the <location> blocks at the end).
  The managed module below stamps the authenticated account into X-Windows-User AFTER the
  handshake; the rewrite rule clears any client-supplied copy first, and Node listens on
  127.0.0.1 only, so the app can trust that header. The app then mints a signed session
  cookie and every other request is authorised by the cookie alone, so the Windows
  handshake happens once per login, not per request. Never enable Windows auth at the
  site root: IIS would then staple a Negotiate challenge onto every application 401 and
  VPN users get a credential prompt on each error.

  Requires, at server level (already present on TelApp1 because FastQuote uses them):
    - URL Rewrite 2.1 and Application Request Routing 3 with "Enable proxy" ticked.
    - Every HTTP_* name set below listed under Allowed Server Variables, or IIS answers 500.50.
    - ASP.NET 4.x (Web-Asp-Net45) and an Integrated .NET 4.0 application pool, or no
      managed module runs at all and X-Windows-User is silently never set.
    - IisProxyAuth.dll in this site's bin\ folder (copy from C:\apps\fastquote\wwwroot\bin;
      source in WindowsUserHeaderModule.cs next to this file).
    - SPN HTTP/erplens.telmaco.gr on the computer account TELAPP1$ for Kerberos.
-->
<configuration>
  <system.webServer>
    <security>
      <authentication>
        <anonymousAuthentication enabled="true" />
        <windowsAuthentication enabled="false" />
      </authentication>
    </security>
    <modules runAllManagedModulesForAllRequests="true">
      <add name="WindowsUserHeaderModule" type="IisProxyAuth.WindowsUserHeaderModule, IisProxyAuth" />
    </modules>
    <rewrite>
      <rules>
        <!-- Planned-maintenance gate. While maintenance.flag exists in the site root, every
             request gets maintenance.html. deploy.ps1 creates the flag before stopping Node and
             removes it (then recycles the pool, because IIS caches this response) when Node is
             back. Unplanned crashes are covered by PM2's auto-restart, not by this rule. -->
        <rule name="Maintenance Mode" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{DOCUMENT_ROOT}/maintenance.flag" matchType="IsFile" />
            <add input="{URL}" pattern="^/maintenance\.html$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/maintenance.html" />
        </rule>
        <rule name="ERPLens Reverse Proxy" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <!-- Destroy any identity header a client tries to send. The managed module re-sets
                 X-Windows-User from the server-side principal on the Windows-auth paths only. -->
            <set name="HTTP_X_WINDOWS_USER" value="" />
            <set name="HTTP_X_USER_ID" value="" />
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3001/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- PassThrough: return Node's own body for every status code so the browser can read
         {ok:false,error} JSON. "Replace" would mask every 4xx/5xx with IIS's stock HTML page
         and silently break client-side error handling (learned the hard way on FastQuote). -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
  <!-- Windows authentication on the two sign-in paths only. -->
  <location path="api/me">
    <system.webServer><security><authentication>
      <anonymousAuthentication enabled="false" />
      <windowsAuthentication enabled="true" />
    </authentication></security></system.webServer>
  </location>
  <location path="api/sso">
    <system.webServer><security><authentication>
      <anonymousAuthentication enabled="false" />
      <windowsAuthentication enabled="true" />
    </authentication></security></system.webServer>
  </location>
</configuration>
